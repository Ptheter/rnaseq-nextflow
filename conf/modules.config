process {
    executor = 'slurm'
    queue    = '128x24'
    time     = '12h'

    withName: 'FASTQC'       { module = 'miniconda3:fastqc/0.12.1'; cpus = 2; memory = '4 GB' }
    withName: 'FASTP'        { module = 'fastp/0.23.2';             cpus = 4; memory = '8 GB' }
    withName: 'SALMON_INDEX' { module = 'miniconda3:salmon/1.10.3'; cpus = 8; memory = '24 GB' }
    withName: 'SALMON_QUANT' { module = 'miniconda3:salmon/1.10.3'; cpus = 8; memory = '16 GB' }
    withName: 'MULTIQC'      { module = 'miniconda3:multiqc/1.27';  cpus = 1; memory = '4 GB' }
    withName: 'FETCH_ENA'    { cpus = 1; memory = '2 GB' }
}

executor {
    queueSize = 20
}
