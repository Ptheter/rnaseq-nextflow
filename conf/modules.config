process {
    executor = 'slurm'
    queue    = '128x24'
    time     = '12h'

    withName: 'FETCH_ENA' {
        cpus          = 1
        memory        = '2 GB'
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }
        maxRetries    = 3
    }
    withName: 'FASTQC' {
        module = 'miniconda3:fastqc/0.12.1'
        cpus   = 2
        memory = { 4.GB * task.attempt }
        errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    withName: 'FASTP' {
        module = 'fastp/0.23.2'
        cpus   = 4
        memory = { 8.GB * task.attempt }
        errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    withName: 'SALMON_INDEX' {
        module = 'miniconda3:salmon/1.10.3'
        cpus   = 8
        memory = { 8.GB * task.attempt }
        errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    withName: 'SALMON_QUANT' {
        module = 'miniconda3:salmon/1.10.3'
        cpus   = 8
        memory = { 16.GB * task.attempt }
        errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    withName: 'MULTIQC' {
        module = 'miniconda3:multiqc/1.27'
        cpus   = 1
        memory = { 4.GB * task.attempt }
        errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
}

executor {
    queueSize = 20
}
