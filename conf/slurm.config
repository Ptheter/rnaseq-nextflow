process {
    executor = 'slurm'
    queue    = '128x24'
    time     = '12h'

    withName: 'FETCH_ENA' {
        cpus   = 1
        memory = '2 GB'
    }
    withName: 'FASTQC' {
        cpus   = 2
        memory = '4 GB'
    }
    withName: 'FASTP' {
        cpus   = 4
        memory = '8 GB'
    }
    withName: 'SALMON_INDEX' {
        cpus   = 8
        memory = '24 GB'
    }
    withName: 'SALMON_QUANT' {
        cpus   = 8
        memory = '16 GB'
    }
    withName: 'MULTIQC' {
        cpus   = 1
        memory = '4 GB'
    }
}

executor {
    queueSize = 20
}
