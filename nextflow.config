params {
    input         = null
    transcriptome = null
    outdir        = 'results'
}

process {
    cpus   = 2
    memory = '4 GB'

    withName: 'SALMON_INDEX' {
        cpus   = 4
        memory = '6 GB'
    }
}

profiles {
    docker { includeConfig 'conf/docker.config' }
    test   { includeConfig 'conf/test.config' }
}
