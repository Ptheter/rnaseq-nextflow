params {
    input         = null
    transcriptome = null
    ena_metadata  = 'metadata/ena_filereport.tsv'
    outdir        = 'results'
}

executor {
    cpus   = 4
    memory = '7 GB'
}

process {
    cpus   = 2
    memory = '4 GB'

    withName: 'FETCH_ENA' {
        cpus   = 1
        memory = '1 GB'
    }
    withName: 'SALMON_INDEX' {
        cpus   = 4
        memory = '6 GB'
    }
}

profiles {
    docker      { includeConfig 'conf/docker.config' }
    singularity { includeConfig 'conf/singularity.config' }
    slurm       { includeConfig 'conf/slurm.config' }
    modules     { includeConfig 'conf/modules.config' }
    test        { includeConfig 'conf/test.config' }
}
